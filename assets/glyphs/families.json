        "north": "switch/x.svg",
        "left_shoulder": "switch/l.svg",
        "right_shoulder": "switch/r.svg",
        "left_trigger": "switch/zl.svg",
        "right_trigger": "switch/zr.svg",
        "start": "switch/plus.svg",
        "back": "switch/minus.svg"
      }
    },
    "steam_controller": {
      "use": ["common", "xbox", "right_trackpad"],
      "absent": ["touchpad"],
      "controls": {"start": "common/start-arrow.svg", "back": "common/back-arrow.svg"}
    }
  }
