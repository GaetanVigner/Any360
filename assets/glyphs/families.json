      "right_x": "common/stick-r.svg",
      "right_y": "common/stick-r.svg",
      "left_x+": "common/stick-l-r.svg",
      "left_x-": "common/stick-l-l.svg",
      "left_y+": "common/stick-l-u.svg",
      "left_y-": "common/stick-l-d.svg",
      "right_x+": "common/stick-r-r.svg",
      "right_x-": "common/stick-r-l.svg",
      "right_y+": "common/stick-r-u.svg",
      "right_y-": "common/stick-r-d.svg",
      "left_up_left": "common/stick-l-ul.svg",
      "left_up_right": "common/stick-l-ur.svg",
      "left_down_left": "common/stick-l-dl.svg",
      "left_down_right": "common/stick-l-dr.svg",
      "right_up_left": "common/stick-r-ul.svg",
      "right_up_right": "common/stick-r-ur.svg",
      "right_down_left": "common/stick-r-dl.svg",
      "right_down_right": "common/stick-r-dr.svg",
      "dpad": "common/dpad.svg",
      "dpad_up": "common/dpad-u.svg",
      "dpad_down": "common/dpad-d.svg",
      "dpad_left": "common/dpad-l.svg",
      "dpad_right": "common/dpad-r.svg",
      "dpad_up_left": "common/dpad-ul.svg",
      "dpad_up_right": "common/dpad-ur.svg",
      "dpad_down_left": "common/dpad-dl.svg",
      "dpad_down_right": "common/dpad-dr.svg",
      "guide": "common/guide.svg"
    },
    "xbox": {
      "south": "xbox/a.svg",
      "east": "xbox/b.svg",
      "west": "xbox/x.svg",
      "north": "xbox/y.svg",
      "left_shoulder": "xbox/lb.svg",
      "right_shoulder": "xbox/rb.svg",
      "left_trigger": "xbox/lt.svg",
      "right_trigger": "xbox/rt.svg"
    },
    "playstation": {
      "south": "playstation/cross.svg",
      "east": "playstation/circle.svg",
      "west": "playstation/square.svg",
      "north": "playstation/triangle.svg",
      "left_shoulder": "playstation/l1.svg",
      "right_shoulder": "playstation/r1.svg",
      "left_trigger": "playstation/l2.svg",
      "right_trigger": "playstation/r2.svg",
      "left_stick": "playstation/l3.svg",
      "right_stick": "playstation/r3.svg"
    },
    "right_trackpad": {
      "right_stick": "steam/pad-r.svg",
      "right_x": "steam/pad-r.svg",
      "right_y": "steam/pad-r.svg",
      "right_x+": "steam/pad-r-r.svg",
      "right_x-": "steam/pad-r-l.svg",
      "right_y+": "steam/pad-r-u.svg",
      "right_y-": "steam/pad-r-d.svg",
      "right_up_left": "steam/pad-r-ul.svg",
      "right_up_right": "steam/pad-r-ur.svg",
      "right_down_left": "steam/pad-r-dl.svg",
      "right_down_right": "steam/pad-r-dr.svg"
