+void RaiseHostTimerResolution() {
+#if defined(_WIN32)
+  static std::once_flag once;
+  std::call_once(once, [] {
+    if (const char* v = std::getenv("ANY360_EXP_NOTIMER"); v && *v == '1') return;  // EXPERIMENT
+    TIMECAPS caps{};
+    const UINT period = timeGetDevCaps(&caps, sizeof caps) == MMSYSERR_NOERROR ? std::max<UINT>(1, caps.wPeriodMin) : 1;
+    timeBeginPeriod(period);
+  });
+#endif
+}
+
+}  // namespace any360::sys
+
+#if defined(_WIN32)
+#include <cstdio>
+namespace any360::sys {
+int ExpEnv(const char* name) {
+  const char* v = std::getenv(name);
+  return v ? std::atoi(v) : 0;
+}
+bool ExpYield(int mode) {
+  if (mode == 1) { Sleep(0); return true; }
+  const bool sw = SwitchToThread() != 0;
+  if (!sw && mode == 2) Sleep(0);
+  return sw;
+}
+void ExpYieldStats(bool switched, int64_t ns) {
+  struct S { uint64_t calls = 0, sw = 0, b[7] = {}; int64_t next = 0; };
+  static thread_local S s;
+  ++s.calls; s.sw += switched;
+  const int64_t us = ns / 1000;
+  s.b[us < 5 ? 0 : us < 20 ? 1 : us < 100 ? 2 : us < 1000 ? 3 : us < 4000 ? 4 : us < 16000 ? 5 : 6]++;
+  const int64_t now = GetTickCount64();
+  if (s.next == 0) s.next = now + 2000;
+  if (now < s.next) return;
+  s.next = now + 2000;
+  std::fprintf(stderr, "yieldstats tid %lu: %llu calls, %llu switched; <5us %llu, <20 %llu, <100 %llu, <1ms %llu, <4ms %llu, <16ms %llu, more %llu\n",
+               GetCurrentThreadId(), (unsigned long long)s.calls, (unsigned long long)s.sw,
+               (unsigned long long)s.b[0], (unsigned long long)s.b[1], (unsigned long long)s.b[2], (unsigned long long)s.b[3],
+               (unsigned long long)s.b[4], (unsigned long long)s.b[5], (unsigned long long)s.b[6]);
+  s = S{}; s.next = now + 2000;
+}
 }  // namespace any360::sys
+#endif
