    "left_y+": "common/stick-l-u.svg",
    "left_y-": "common/stick-l-d.svg",
    "right_x+": "common/stick-r-r.svg",
    "right_x-": "common/stick-r-l.svg",
    "right_y+": "common/stick-r-u.svg",
    "right_y-": "common/stick-r-d.svg",
    "left_up_left": "common/stick-l-ul.svg",
    "left_up_right": "common/stick-l-ur.svg",
    "left_down_left": "common/stick-l-dl.svg",
    "left_down_right": "common/stick-l-dr.svg",
    "right_up_left": "common/stick-r-ul.svg",
    "right_up_right": "common/stick-r-ur.svg",
    "right_down_left": "common/stick-r-dl.svg",
    "right_down_right": "common/stick-r-dr.svg",
    "dpad": "common/dpad.svg",
    "dpad_up": "common/dpad-u.svg",
    "dpad_down": "common/dpad-d.svg",
    "dpad_left": "common/dpad-l.svg",
    "dpad_right": "common/dpad-r.svg",
    "dpad_up_left": "common/dpad-ul.svg",
