  "families": {
    "xbox360": {
      "use": ["common", "xbox"],
      "absent": ["touchpad"],
      "controls": {"start": "common/start-arrow.svg", "back": "common/back-arrow.svg"}
    },
    "xbox_one": {
      "use": ["common", "xbox"],
      "absent": ["touchpad"],
      "controls": {"start": "xbox/menu.svg", "back": "xbox/view.svg"}
    },
    "ps3": {
      "use": ["common", "playstation"],
      "absent": ["touchpad"],
      "controls": {"start": "ps3/start.svg", "back": "ps3/select.svg"}
    },
    "ps4": {
      "use": ["common", "playstation"],
      "controls": {"start": "ps4/options.svg", "back": "ps4/share.svg", "touchpad": "playstation/touchpad.svg"}
    },
    "ps5": {
      "use": ["common", "playstation"],
      "controls": {"start": "ps5/options.svg", "back": "ps5/create.svg", "touchpad": "playstation/touchpad.svg"}
